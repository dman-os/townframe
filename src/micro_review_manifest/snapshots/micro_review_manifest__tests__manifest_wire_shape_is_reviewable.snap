---
source: src/micro_review_manifest/lib.rs
expression: sidecar()
---
id: dayframe.review
package_version: 1
authority: org.example.dayframe.review
entrypoints:
  initialize: "townframe:dayframe/micro-lifecycle@0.4.0"
  presentation: "townframe:dayframe/presentation-events@0.4.0"
  installer: ~
publications:
  - name: view
    kind: presentation
    contract: ~
requires: []
configuration_requests:
  - binding: review
    facets:
      - tag: org.example.dayframe.review.config
        key_id: main
        read: true
        write: true
        create: false
        delete: false
collection_contracts: []
collection_requests:
  - binding: panels
    contract: org.example.dayframe.layout.panels
    access: write
    necessity: optional
contributions:
  - id: layout-panel
    binding: panels
    key: dayframe.review
    payload:
      content:
        $attachment: 0
      title: Review
    attachments:
      - index: 0
        publication: view
interimMethods:
  - org.example.daybook.docs.readDatums
  - org.example.daybook.docs.pollDatums
