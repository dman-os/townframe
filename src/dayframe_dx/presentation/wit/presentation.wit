package townframe:dayframe@0.1.0;

/// Retained presentation, independent of the guest framework and execution engine.
/// These resources are issued by the host, never obtained by guessing a global ID.
interface presentation {
    /// Dioxus element identities are local to one surface, including its interpreter stack.
    type node-id = u32;

    variant presentation-error {
        revoked,
        unsupported(string),
        invalid-batch(string),
    }

    /// Attribute values that can cross an address space. Dioxus's `Any` attribute carries a
    /// process-local Rust object and is deliberately absent: a guest adapter must reject it.
    variant attribute-value {
        text(string),
        float(f64),
        int(s64),
        boolean(bool),
        /// Removes the attribute.
        none,
    }

    /// One operation of the retained-tree stack machine. The variants mirror Dioxus Core's
    /// `WriteMutations` one-to-one so that any framework adapter (Dioxus, React, Vue, …) can
    /// target the same host writer; this is a typed transport of that vocabulary, not a second
    /// rendering language. The host replays a batch into its own tree writer in order.
    variant mutation {
        push-id(node-id),
        set-id(node-id),
        child(u32),
        pop,
        create-element(tuple<string, option<string>>),
        create-text(string),
        clone-node,
        append-children(u32),
        replace-with(u32),
        insert-after(u32),
        insert-before(u32),
        set-attribute(tuple<string, option<string>, attribute-value>),
        set-text(string),
        add-event-listener(string),
        remove-event-listener(string),
        remove,
    }

    resource surface {
        /// Commits one ordered batch of edits against this surface's tree. A batch is applied
        /// atomically with respect to other batches on the same surface. The receipt describes
        /// the logical edit commit, not completion of layout or paint.
        apply: func(edits: list<mutation>) -> result<u64, presentation-error>;
        retain: func() -> result<surface, presentation-error>;
        identity: func() -> u64;
    }

    resource mount-point {
        /// Opens one owned surface in this explicitly granted placement.
        open: func() -> result<surface, presentation-error>;
    }
}

/// Synchronous event delivery permits browser default-action decisions before dispatch returns.
/// A framework adapter dispatches by element and event name; closures never cross WIT.
interface presentation-events {
    use presentation.{surface, mount-point, presentation-error, node-id};

    /// Mirrors Dioxus HtmlEvent's envelope and preserves its serialized EventData payload.
    /// The surface supplies render-target scope; element IDs never identify application-global nodes.
    record event {
        /// The logical-tree revision against which the host selected the event target.
        revision: u64,
        element: node-id,
        name: string,
        bubbles: bool,
        /// JSON produced by Dioxus's serialized HTML event adapter, not a second event schema.
        data-json: string,
    }

    record event-response {
        prevent-default: bool,
        stop-propagation: bool,
    }

    /// The host retains the placement and receives the owned surface for event routing and cleanup.
    /// The guest receives a borrowed placement, not authority to mount at arbitrary application roots.
    mount: func(placement: borrow<mount-point>) -> result<surface, presentation-error>;

    unmount: func(surface: borrow<surface>);
    dispatch: func(surface: borrow<surface>, event: event) -> event-response;
}

/// Renderer-adapter contract only. Feature worlds add their explicit capability imports and async
/// entry point; this world is not a universal micro context or an application service locator.
world presentation-client {
    import presentation;
    export presentation-events;
}
