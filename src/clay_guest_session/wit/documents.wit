package townframe:dayframe@0.4.0;

interface documents {
    type doc-id = string;
    type facet-raw = string;

    record facet-key {
        tag: string,
        key-id: string,
    }

    record facet-route {
        document: doc-id,
        branch: string,
        key: facet-key,
    }

    variant facet-selection {
        tags(list<string>),
        keys(list<facet-key>),
    }

    record watch-selection {
        documents: list<doc-id>,
        branch: string,
        facets: facet-selection,
    }

    variant document-error {
        denied,
        revoked,
        invalid-value(string),
        subscription-lagged,
    }

    variant facet-value {
        loading,
        absent,
        present(facet-raw),
    }

    record facet-entry {
        route: facet-route,
        value: facet-value,
    }

    record document-snapshot {
        watch-id: u64,
        revision: u64,
        facets: list<facet-entry>,
        pending: list<u64>,
        refreshing: bool,
        revoked: bool,
    }

    record transport-failure {
        message: string,
        outcome-unknown: bool,
    }

    variant operation-failure {
        rejected(string),
        transport(transport-failure),
    }

    variant operation-status {
        locally-applied,
        accepted,
        rolled-back(operation-failure),
    }

    record operation-receipt {
        id: u64,
        revision: u64,
        status: operation-status,
    }

    variant facet-mutation {
        update(facet-raw),
        create(facet-raw),
        delete,
    }

    resource operation {
        current: func() -> result<operation-receipt, document-error>;
    }

    resource document-watch {
        current: func() -> result<document-snapshot, document-error>;
        select: func(selection: watch-selection) -> result<_, document-error>;
        refresh: func() -> result<_, document-error>;
    }

    resource document-access {
        watch: func(selection: watch-selection) -> result<document-watch, document-error>;
        mutate: func(route: facet-route, mutation: facet-mutation) -> result<operation, document-error>;
    }

    record document-binding {
        name: string,
        document: doc-id,
        branch: string,
        access: document-access,
    }
}

interface document-events {
    use documents.{document-snapshot, operation-receipt};

    changed: func(snapshot: document-snapshot);
    lagged: func(watch-id: u64);
    completed: func(receipt: operation-receipt);
}

/// One initialization entry point per incarnation (ADR 024 §5). Everything the guest publishes
/// while `initialize` runs (registration rows, capability publications) stays invisible to
/// other micros until it returns `ok`; an error, trap, or cancellation drops it unseen.
interface micro-lifecycle {
    use documents.{document-binding};
    use collections.{collection-binding};
    use collection-registration.{registration-binding};
    use capability-bank.{capability-ref, published-capability};

    /// A resolved requirement: the local binding name the manifest declares and the provider's
    /// capability, minted for this incarnation.
    record requirement-binding {
        name: string,
        capability: capability-ref,
    }

    /// One-shot initialization input. `arguments` is opaque, configuration-supplied CBOR.
    record initial-context {
        arguments: list<u8>,
        configs: list<document-binding>,
        collections: list<collection-binding>,
        registrations: list<registration-binding>,
        requirements: list<requirement-binding>,
    }

    variant initialization-error {
        invalid-configuration(string),
        unavailable(string),
        rejected(string),
    }

    /// Proof of successful initialization, held by the host for the incarnation. The host calls
    /// `close` exactly once, while the incarnation's dependencies are still live, and drops the
    /// root afterwards. It is not a stop capability: the guest never receives it back.
    resource instance-root {
        close: async func() -> result<_, string>;
    }

    /// A publication this incarnation serves, by the name its manifest declares (ADR 025 §8).
    /// The host owns the publication lease for the rest of the incarnation and checks the name,
    /// kind and contract against the manifest; a mismatch fails the initialization.
    record named-publication {
        name: string,
        capability: published-capability,
    }

    record initialized {
        root: instance-root,
        publications: list<named-publication>,
    }

    initialize: async func(context: initial-context) -> result<initialized, initialization-error>;

    /// Serve one call publication (ADR 025 §5). The host routes every call into this
    /// incarnation's own store; `publication` is the name given to `publish-call`. The error is
    /// the provider's own rejection, carried to the caller as `call-error.provider`.
    call: async func(publication: string, request: list<u8>) -> result<list<u8>, string>;
}

world micro-client {
    include presentation-client;
    import documents;
    import collections;
    import collection-registration;
    import capability-bank;
    export document-events;
    export micro-lifecycle;
}
