{
  "$description": "claytxt foundation primitives. Values are DTCG-compatible and may be consumed by semantic.tokens.json.",
  "dimension": {
    "$type": "dimension",
    "spacing": {
      "0": { "$value": { "value": 0, "unit": "rem" } },
      "1": { "$value": { "value": 0.25, "unit": "rem" } },
      "2": { "$value": { "value": 0.5, "unit": "rem" } },
      "3": { "$value": { "value": 0.75, "unit": "rem" } },
      "4": { "$value": { "value": 1, "unit": "rem" } },
      "6": { "$value": { "value": 1.5, "unit": "rem" } },
      "8": { "$value": { "value": 2, "unit": "rem" } },
      "12": { "$value": { "value": 3, "unit": "rem" } },
      "36": { "$value": { "value": 9, "unit": "rem" } }
    },
    "radius": {
      "sm": { "$value": { "value": 0.25, "unit": "rem" } },
      "md": { "$value": { "value": 0.5, "unit": "rem" } },
      "lg": { "$value": { "value": 0.75, "unit": "rem" } },
      "xl": { "$value": { "value": 1, "unit": "rem" } },
      "pill": { "$value": { "value": 999, "unit": "px" } }
    },
    "border": {
      "hairline": { "$value": { "value": 1, "unit": "px" } },
      "thin": { "$value": { "value": 1, "unit": "px" } },
      "thick": { "$value": { "value": 2, "unit": "px" } }
    },
    "font-size": {
      "sm": { "$value": { "value": 0.875, "unit": "rem" } },
      "md": { "$value": { "value": 1, "unit": "rem" } },
      "lg": { "$value": { "value": 1.125, "unit": "rem" } }
    }
  },
  "color": {
    "$type": "color",
    "$description": "The shadow ink is the only primitive colour left; every other colour is the palette (palette.tokens.json).",
    "neutral": {
      "1000": {
        "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 1 }
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["system-ui", "sans-serif"] },
      "mono": {
        "$value": [
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "Consolas",
          "Liberation Mono",
          "monospace"
        ]
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    }
  },
  "shadow": {
    "$type": "shadow",
    "none": { "$value": [] },
    "sm": {
      "$value": [
        {
          "color": "{color.neutral.1000}",
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 1, "unit": "px" },
          "blur": { "value": 2, "unit": "px" },
          "spread": { "value": 0, "unit": "px" }
        }
      ]
    },
    "md": {
      "$value": [
        {
          "color": "{color.neutral.1000}",
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 4, "unit": "px" },
          "blur": { "value": 12, "unit": "px" },
          "spread": { "value": 0, "unit": "px" }
        }
      ]
    },
    "raised": {
      "$value": [
        {
          "color": "{color.neutral.1000}",
          "offsetX": { "value": 0, "unit": "px" },
          "offsetY": { "value": 8, "unit": "px" },
          "blur": { "value": 24, "unit": "px" },
          "spread": { "value": 0, "unit": "px" }
        }
      ]
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "short": { "$value": { "value": 150, "unit": "ms" } },
      "medium": { "$value": { "value": 250, "unit": "ms" } }
    },
    "easing": {
      "$type": "cubicBezier",
      "decelerate": { "$value": [0.05, 0.7, 0.1, 1] }
    }
  }
}
