---
source: src/micro_shell_manifest/lib.rs
expression: sidecar()
---
id: dayframe.shell
package_version: 1
authority: org.example.dayframe.shell
entrypoints:
  initialize: "townframe:dayframe/micro-lifecycle@0.4.0"
  presentation: "townframe:dayframe/presentation-events@0.4.0"
  installer: ~
endpoints:
  back:
    $type: "org.example.clay.micro.manifest#methodEndpoint"
    nsid: org.example.dayframe.shell.back
  close-sheet:
    $type: "org.example.clay.micro.manifest#methodEndpoint"
    nsid: org.example.dayframe.shell.closeSheet
  forward:
    $type: "org.example.clay.micro.manifest#methodEndpoint"
    nsid: org.example.dayframe.shell.forward
  frame:
    $type: "org.example.clay.micro.manifest#viewEndpoint"
  get-theme:
    $type: "org.example.clay.micro.manifest#methodEndpoint"
    nsid: org.example.dayframe.shell.getTheme
  home:
    $type: "org.example.clay.micro.manifest#viewEndpoint"
  nav-button:
    $type: "org.example.clay.micro.manifest#viewEndpoint"
    implements: org.example.dayframe.shell.navButton
  navigate:
    $type: "org.example.clay.micro.manifest#methodEndpoint"
    nsid: org.example.dayframe.shell.navigate
  open-sheet:
    $type: "org.example.clay.micro.manifest#methodEndpoint"
    nsid: org.example.dayframe.shell.openSheet
  opened:
    $type: "org.example.clay.micro.manifest#methodEndpoint"
    nsid: org.example.dayframe.shell.opened
  set-theme:
    $type: "org.example.clay.micro.manifest#methodEndpoint"
    nsid: org.example.dayframe.shell.setTheme
requires: []
configuration_requests:
  - binding: shell
    facets:
      - tag: org.example.dayframe.shell.config
        key_id: main
        read: true
        write: true
        create: false
        delete: false
  - binding: shell-theme
    facets:
      - tag: org.example.dayframe.shell.theme
        key_id: main
        read: true
        write: true
        create: false
        delete: false
collection_contracts:
  - id: org.example.dayframe.shell.panels
    selector_schema: org.example.dayframe.shell.panelSelector
    key_schema: org.example.dayframe.shell.panelKey
    value_schema: org.example.dayframe.shell.panel
    write_context_schema: ~
    offered:
      - read
      - register
collection_requests:
  - binding: panels
    contract: org.example.dayframe.shell.panels
    access: read
  - binding: home-panel
    contract: org.example.dayframe.shell.panels
    access: write
  - binding: roots
    contract: "org.example.clay.shell#roots"
    access: write
contributions:
  - id: home-panel
    binding: home-panel
    key: dayframe.shell
    value:
      content:
        $link: 0
      home: true
      sockets:
        - list
      title: Home
    links:
      - index: 0
        endpoint: home
  - id: root
    binding: roots
    key: dayframe.shell
    value:
      content:
        $link: 0
      title: Shell
    links:
      - index: 0
        endpoint: frame
