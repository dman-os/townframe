---
source: src/micro_layout_manifest/lib.rs
expression: sidecar()
---
id: dayframe.layout
package_version: 1
authority: org.example.dayframe.layout
entrypoints:
  initialize: "townframe:dayframe/micro-lifecycle@0.4.0"
  presentation: "townframe:dayframe/presentation-events@0.4.0"
  installer: ~
publications:
  - name: view
    kind: presentation
    contract: ~
requires:
  - binding: nav-button
    contract: org.example.dayframe.shell.navButton
configuration_requests:
  - binding: layout
    facets:
      - tag: org.example.dayframe.layout.config
        key_id: main
        read: true
        write: true
        create: false
        delete: false
collection_contracts:
  - id: org.example.dayframe.layout.panels
    selector_schema: org.example.dayframe.layout.panelSelector
    key_schema: org.example.dayframe.layout.panelKey
    value_schema: org.example.dayframe.layout.panel
    write_context_schema: ~
    offered:
      - read
      - register
collection_requests:
  - binding: panels
    contract: org.example.dayframe.layout.panels
    access: read
  - binding: shell-panels
    contract: org.example.dayframe.shell.panels
    access: write
contributions:
  - id: panel
    binding: shell-panels
    key: dayframe.layout
    payload:
      content:
        $attachment: 0
      sockets:
        - list
      title: Layout
    attachments:
      - index: 0
        publication: view
