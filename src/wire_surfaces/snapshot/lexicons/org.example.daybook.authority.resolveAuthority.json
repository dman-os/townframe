{
  "defs": {
    "Actor": {
      "nullable": [
        "parentActorId"
      ],
      "properties": {
        "actorId": {
          "type": "string"
        },
        "certificate": {
          "type": "bytes"
        },
        "parentActorId": {
          "type": "string"
        },
        "publicKey": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "actorId",
        "url",
        "publicKey",
        "certificate"
      ],
      "type": "object"
    },
    "Capability": {
      "nullable": [
        "subject"
      ],
      "properties": {
        "capabilityId": {
          "type": "string"
        },
        "issuerId": {
          "type": "string"
        },
        "object": {
          "type": "string"
        },
        "rights": {
          "ref": "#Rights",
          "type": "ref"
        },
        "subject": {
          "type": "string"
        }
      },
      "required": [
        "capabilityId",
        "object",
        "rights",
        "issuerId"
      ],
      "type": "object"
    },
    "ResolvedAuthority": {
      "nullable": [
        "actor"
      ],
      "properties": {
        "actor": {
          "ref": "#Actor",
          "type": "ref"
        },
        "capability": {
          "ref": "#Capability",
          "type": "ref"
        }
      },
      "required": [
        "capability"
      ],
      "type": "object"
    },
    "Rights": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "main": {
      "errors": [
        {
          "name": "InvalidCapability"
        },
        {
          "name": "Unauthorized"
        },
        {
          "name": "Escalation"
        },
        {
          "name": "UnrecognizedActor"
        },
        {
          "name": "InvalidActorPath"
        },
        {
          "name": "ActorNotFound"
        },
        {
          "name": "StateCorrupt"
        },
        {
          "name": "Storage"
        },
        {
          "name": "Claim"
        }
      ],
      "output": {
        "encoding": "application/json",
        "schema": {
          "ref": "#ResolvedAuthority",
          "type": "ref"
        }
      },
      "parameters": {
        "properties": {
          "capability": {
            "type": "string"
          }
        },
        "required": [
          "capability"
        ],
        "type": "params"
      },
      "type": "query"
    }
  },
  "id": "org.example.daybook.authority.resolveAuthority",
  "lexicon": 1
}
