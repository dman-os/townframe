{
  "defs": {
    "BlobInfo": {
      "properties": {
        "blobId": {
          "type": "string"
        },
        "lengthOctets": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "blobId",
        "lengthOctets"
      ],
      "type": "object"
    },
    "ImportFileOutput": {
      "properties": {
        "results": {
          "items": {
            "ref": "#ImportFileResult",
            "type": "ref"
          },
          "type": "array"
        }
      },
      "required": [
        "results"
      ],
      "type": "object"
    },
    "ImportFileRefusal": {
      "properties": {
        "code": {
          "enum": [
            "tooLarge",
            "unreadable",
            "invalidInput",
            "storage"
          ],
          "type": "string"
        },
        "limitOctets": {
          "minimum": 0,
          "type": "integer"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "code"
      ],
      "type": "object"
    },
    "ImportFileResult": {
      "properties": {
        "error": {
          "ref": "#ImportFileRefusal",
          "type": "ref"
        },
        "info": {
          "ref": "#BlobInfo",
          "type": "ref"
        },
        "kind": {
          "enum": [
            "imported",
            "refused"
          ],
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "main": {
      "errors": [
        {
          "name": "Denied"
        },
        {
          "name": "NotFound"
        },
        {
          "description": "The item is over the node's size limit for one put (ADR 042 §6). For a batch import this is\nthe refusal of that item alone.",
          "name": "TooLarge"
        },
        {
          "description": "The body of a put failed while the node read it: the upload was cut off.",
          "name": "Unreadable"
        },
        {
          "description": "A read asked for a range that selects no octet of the blob.",
          "name": "RangeNotSatisfiable"
        },
        {
          "name": "InvalidInput"
        },
        {
          "name": "Storage"
        }
      ],
      "input": {
        "encoding": "application/x-descriptors"
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "ref": "#ImportFileOutput",
          "type": "ref"
        }
      },
      "parameters": {
        "properties": {
          "capability": {
            "type": "string"
          }
        },
        "required": [
          "capability"
        ],
        "type": "params"
      },
      "type": "procedure"
    }
  },
  "id": "org.example.daybook.blobs.importFile",
  "lexicon": 1
}
