{
  "defs": {
    "SuccessorResolution": {
      "properties": {
        "drawerId": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "noSuccessor",
            "resolved",
            "accessRequired"
          ],
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "main": {
      "description": "Follow the successor chain with Read access at every hop; stop with AccessRequired before\nreading an inaccessible hop. Cycle-checked; creates nothing.",
      "errors": [
        {
          "name": "Denied"
        },
        {
          "name": "SelfChild"
        },
        {
          "name": "Authority"
        },
        {
          "name": "AuthorityUnavailable"
        },
        {
          "name": "Docs"
        },
        {
          "name": "DocsUnavailable"
        },
        {
          "description": "Keyhive storage or the engine failed; nothing the caller named is at fault.",
          "name": "Keyhive"
        },
        {
          "description": "A named group or doc id that is not a 32-byte Ed25519 point.",
          "name": "InvalidKey"
        },
        {
          "description": "A Keyhive group this node does not hold, perhaps not yet synced.",
          "name": "UnknownGroup"
        },
        {
          "description": "A principal group the caller named that this node does not hold.",
          "name": "UnknownPrincipal"
        },
        {
          "name": "Storage"
        },
        {
          "name": "UnknownDrawer"
        },
        {
          "description": "A peer this node has not met: its keyhive identity arrives with a live connection.",
          "name": "UnknownPeer"
        },
        {
          "name": "SelfDoc"
        },
        {
          "name": "AlreadyDrawer"
        },
        {
          "name": "NotAnEntry"
        },
        {
          "name": "ForeignLayout"
        },
        {
          "name": "CommandInFlight"
        },
        {
          "name": "CommandReused"
        },
        {
          "name": "RosterUnreadable"
        },
        {
          "name": "InvalidMetaDocSlot"
        },
        {
          "name": "SuccessorCycle"
        },
        {
          "name": "SuccessorSelf"
        }
      ],
      "output": {
        "encoding": "application/json",
        "schema": {
          "ref": "#SuccessorResolution",
          "type": "ref"
        }
      },
      "parameters": {
        "properties": {
          "capability": {
            "type": "string"
          },
          "drawerId": {
            "type": "string"
          }
        },
        "required": [
          "capability",
          "drawerId"
        ],
        "type": "params"
      },
      "type": "query"
    }
  },
  "id": "org.example.daybook.drawers.resolveDrawerSuccessor",
  "lexicon": 1
}
