{
  "defs": {
    "WriteDatums": {
      "nullable": [
        "command"
      ],
      "properties": {
        "capability": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "docId": {
          "type": "string"
        },
        "mode": {
          "ref": "#WriteMode",
          "type": "ref"
        },
        "remove": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "set": {
          "type": "unknown"
        }
      },
      "required": [
        "capability",
        "docId",
        "mode"
      ],
      "type": "object"
    },
    "WriteMode": {
      "properties": {
        "datums": {
          "type": "unknown"
        },
        "heads": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "mode": {
          "enum": [
            "ifDocUnchanged",
            "ifDatumsUnchanged",
            "atHeads",
            "atCurrent"
          ],
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "type": "object"
    },
    "WriteReceipt": {
      "properties": {
        "docId": {
          "type": "string"
        },
        "heads": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "docId",
        "heads"
      ],
      "type": "object"
    },
    "main": {
      "errors": [
        {
          "name": "Denied"
        },
        {
          "name": "InvalidCommand"
        },
        {
          "name": "UnrelatedHistory"
        },
        {
          "name": "Authority"
        },
        {
          "name": "AuthorityUnavailable"
        },
        {
          "name": "Access"
        },
        {
          "name": "Repository"
        },
        {
          "name": "DocNotFound"
        },
        {
          "name": "UnknownHeads"
        },
        {
          "description": "A document id arrived in a request that is not the 32 bytes every document id is. Ids are\nvariable-width keys on the wire (ADR 012), but a document's id is its ed25519 key, so\nonly a 32-byte one can name a document; refusing here keeps the width from ever reaching\nthe repository, where it is an invariant.",
          "name": "InvalidDocId"
        },
        {
          "name": "CommandInFlight"
        },
        {
          "name": "CommandReused"
        },
        {
          "name": "UnknownSchema"
        },
        {
          "name": "SystemDatum"
        },
        {
          "name": "SetAndRemoved"
        },
        {
          "name": "InvalidValue"
        },
        {
          "name": "ValueTooLarge"
        },
        {
          "name": "Conflict"
        },
        {
          "name": "BaseNotAccepted"
        },
        {
          "name": "Pending"
        },
        {
          "name": "ResourceRefused"
        },
        {
          "name": "Unsupported"
        },
        {
          "name": "MalformedEvidence"
        }
      ],
      "input": {
        "encoding": "application/json",
        "schema": {
          "ref": "#WriteDatums",
          "type": "ref"
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "ref": "#WriteReceipt",
          "type": "ref"
        }
      },
      "type": "procedure"
    }
  },
  "id": "org.example.daybook.docs.writeDatums",
  "lexicon": 1
}
