{
  "defs": {
    "OpenActor": {
      "properties": {
        "parent": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "rights": {
          "ref": "#Rights",
          "type": "ref"
        }
      },
      "required": [
        "parent",
        "path",
        "rights"
      ],
      "type": "object"
    },
    "OpenedActor": {
      "nullable": [
        "parentActorId"
      ],
      "properties": {
        "actorId": {
          "type": "string"
        },
        "capability": {
          "type": "string"
        },
        "certificate": {
          "type": "bytes"
        },
        "parentActorId": {
          "type": "string"
        },
        "publicKey": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "actorId",
        "url",
        "publicKey",
        "certificate",
        "capability"
      ],
      "type": "object"
    },
    "Rights": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "main": {
      "description": "Open (or reopen) the child actor at `path` under the actor `parent` is the identity\ncapability of. Unprivileged, because it can reach only the parent's own children: `parent`\nmust be an identity capability carrying `MINT_CHILD` (`UnrecognizedActor` or `Unauthorized`),\n`path` must be the parent actor's path plus exactly one segment (`InvalidActorPath`, which\nis what keeps siblings, ancestors and unrelated actors out of reach), and `rights` must be a\nsubset of the parent's (`Escalation`).",
      "errors": [
        {
          "name": "InvalidCapability"
        },
        {
          "name": "Unauthorized"
        },
        {
          "name": "Escalation"
        },
        {
          "name": "UnrecognizedActor"
        },
        {
          "name": "InvalidActorPath"
        },
        {
          "name": "ActorNotFound"
        },
        {
          "name": "StateCorrupt"
        },
        {
          "name": "Storage"
        },
        {
          "name": "Claim"
        }
      ],
      "input": {
        "encoding": "application/json",
        "schema": {
          "ref": "#OpenActor",
          "type": "ref"
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "ref": "#OpenedActor",
          "type": "ref"
        }
      },
      "type": "procedure"
    }
  },
  "id": "org.example.daybook.authority.openActor",
  "lexicon": 1
}
