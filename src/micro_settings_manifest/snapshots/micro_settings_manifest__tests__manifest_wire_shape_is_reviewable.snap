---
source: src/micro_settings_manifest/lib.rs
expression: manifest()
---
schema: 1
id: dayframe.settings
package_version: 1
entrypoints:
  initialize: "townframe:dayframe/micro-lifecycle@0.4.0"
  presentation: "townframe:dayframe/presentation-events@0.4.0"
  installer: ~
publications:
  - name: view
    kind: presentation
    contract: ~
requires: []
configuration_requests:
  - binding: settings
    facets:
      - owner_plug_id: ~
        tag: org.dayframe.settings.config
        key_id: main
        read: true
        write: true
        create: false
        delete: false
collection_contracts:
  - id: settings.sections
    selector_schema: dayframe.collection.whole
    key_schema: dayframe.settings.section-key
    value_schema: dayframe.settings.section
    write_context_schema: ~
    offered:
      - read
      - register
collection_requests:
  - binding: sections
    contract: settings.sections
    access: read
    necessity: required
    resolution: configured
contributions:
  - id: root
    collection: shell.roots
    key: dayframe.settings
    payload:
      content:
        $attachment: 0
      title: Settings
    attachments:
      - index: 0
        publication: view
