---
source: src/micro_settings_manifest/lib.rs
expression: sidecar()
---
id: dayframe.settings
package_version: 1
authority: org.example.dayframe.settings
entrypoints:
  initialize: "townframe:dayframe/micro-lifecycle@0.4.0"
  presentation: "townframe:dayframe/presentation-events@0.4.0"
  installer: ~
publications:
  - name: list
    kind: presentation
    contract: ~
  - name: section
    kind: presentation
    contract: ~
requires:
  - binding: navigate
    contract: org.example.dayframe.shell.navigate
  - binding: opened
    contract: org.example.dayframe.shell.opened
  - binding: nav-button
    contract: org.example.dayframe.shell.navButton
configuration_requests:
  - binding: settings
    facets:
      - tag: org.example.dayframe.settings.config
        key_id: main
        read: true
        write: true
        create: false
        delete: false
collection_contracts:
  - id: org.example.dayframe.settings.sections
    selector_schema: org.example.dayframe.settings.sectionSelector
    key_schema: org.example.dayframe.settings.sectionKey
    value_schema: org.example.dayframe.settings.section
    write_context_schema: ~
    offered:
      - read
      - register
collection_requests:
  - binding: sections
    contract: org.example.dayframe.settings.sections
    access: read
  - binding: panels
    contract: org.example.dayframe.shell.panels
    access: write
contributions:
  - id: panel
    binding: panels
    key: dayframe.settings
    payload:
      content:
        $attachment: 0
      details:
        $attachment: 1
      sockets:
        - list
      title: Settings
    attachments:
      - index: 0
        publication: list
      - index: 1
        publication: section
