---
source: src/micro_settings_manifest/lib.rs
expression: manifest()
---
schema: 1
id: dayframe.settings
package_version: 1
entrypoints:
  initialize: "townframe:dayframe/micro-lifecycle@0.3.0"
  presentation: "townframe:dayframe/presentation-events@0.3.0"
  installer: ~
provides:
  - id: sections
    contract:
      id: settings.sections
      version: 1
    retention: strong
  - id: controller
    contract:
      id: settings.controller
      version: 1
    retention: strong
requires: []
configuration_requests:
  - binding: settings
    facets:
      - owner_plug_id: ~
        tag: org.dayframe.settings.config
        key_id: main
        read: true
        write: true
        create: false
        delete: false
collection_contracts: []
contributions: []
activation_defaults: []
