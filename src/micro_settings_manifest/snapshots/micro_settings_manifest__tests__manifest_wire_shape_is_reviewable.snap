---
source: src/micro_settings_manifest/lib.rs
expression: manifest()
---
id: dayframe.settings
version: 1
requirements: []
provisions:
  - id: settings.sections
    version: 1
  - id: settings.controller
    version: 1
config:
  name: settings
  facets:
    - owner_plug_id: ~
      tag: org.dayframe.settings.config
      key_id: main
      read: true
      write: true
      create: false
      delete: false
contributions: []
