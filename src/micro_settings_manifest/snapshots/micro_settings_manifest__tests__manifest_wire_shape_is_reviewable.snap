---
source: src/micro_settings_manifest/lib.rs
expression: sidecar()
---
id: dayframe.settings
package_version: 1
authority: org.example.dayframe.settings
entrypoints:
  initialize: "townframe:dayframe/micro-lifecycle@0.4.0"
  presentation: "townframe:dayframe/presentation-events@0.4.0"
  installer: ~
publications:
  - name: view
    kind: presentation
    contract: ~
requires: []
configuration_requests:
  - binding: settings
    facets:
      - tag: org.example.dayframe.settings.config
        key_id: main
        read: true
        write: true
        create: false
        delete: false
collection_contracts:
  - id: org.example.dayframe.settings.sections
    selector_schema: org.example.dayframe.settings.sectionSelector
    key_schema: org.example.dayframe.settings.sectionKey
    value_schema: org.example.dayframe.settings.section
    write_context_schema: ~
    offered:
      - read
      - register
collection_requests:
  - binding: sections
    contract: org.example.dayframe.settings.sections
    access: read
    necessity: required
    resolution: configured
  - binding: roots
    contract: org.example.clay.shell.roots
    access: write
    necessity: required
    resolution: configured
contributions:
  - id: root
    binding: roots
    key: dayframe.settings
    payload:
      content:
        $attachment: 0
      title: Settings
    attachments:
      - index: 0
        publication: view
