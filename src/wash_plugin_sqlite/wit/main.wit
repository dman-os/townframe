package townframe:sqlite;

interface types {
  variant query-error {
    invalid-params(string),
    invalid-query(string),
    unexpected(string),
  }

  variant sql-value {
    null,
    integer(s64),
    real(f64),
    text(string),
    blob(list<u8>),
  }

  record result-set {
    columns: list<string>,
    rows: list<list<sql-value>>,
  }

  record execute-result {
    rows-affected: u64,
    last-insert-rowid: s64,
    result-set: result-set,
  }
}

interface sqlite-connection {
  use types.{sql-value, result-set, execute-result, query-error};

  resource transaction {
    query: func(query: string, params: list<sql-value>) -> result<result-set, query-error>;
    execute: func(query: string, params: list<sql-value>) -> result<execute-result, query-error>;
    execute-batch: func(query: string) -> result<execute-result, query-error>;
    commit: func() -> result<_, query-error>;
    rollback: func() -> result<_, query-error>;
  }

  resource connection {
    query: func(query: string, params: list<sql-value>) -> result<result-set, query-error>;
    execute: func(query: string, params: list<sql-value>) -> result<execute-result, query-error>;
    execute-batch: func(query: string) -> result<execute-result, query-error>;
    sqlite-file-path: func() -> string;
    begin-transaction: func() -> result<transaction, query-error>;
  }
}

world host {
  import sqlite-connection;
}
