package townframe:api-utils;

interface utils {
  use wasi:clocks/wall-clock@0.2.6.{datetime as dt};

  record errors-validation {
    issues: list<tuple<string, string>>,
  }

  record error-internal {
    message: string,
  }

  type datetime = dt;

  type uuid = string;

  type json = string;

  /// note: we don't include the errors since we don't want those generated
  noop: func(inc: tuple<errors-validation, error-internal, datetime, uuid>) -> result;
}

interface http-service {
  use townframe:sqlite/sqlite-connection.{connection as sqlite-connection-token};

  record service-args {
    sqlite-connections: list<tuple<string, sqlite-connection-token>>,
  }

  /// Acquire service args (capabilities) for an http-service component.
  get-args: func() -> service-args;
}

interface mail {
  record email-message {
    to: string,
    subject: string,
    html: string,
    from-address: option<string>,
    reply-to: option<string>,
  }

  variant mail-error {
    send-failed(string),
  }

  send: func(message: email-message) -> result<_, mail-error>;
}

world imports {
  import wasi:io/poll@0.2.6;
  import wasi:clocks/monotonic-clock@0.2.6;
  import wasi:clocks/wall-clock@0.2.6;
  import wasi:config/runtime@0.2.0-draft;
  import wasi:keyvalue/store@0.2.0-draft;
  import wasi:keyvalue/atomics@0.2.0-draft;
  import wasi:logging/logging@0.1.0-draft;
  import wasmcloud:postgres/types@0.1.1-draft;
  import wasmcloud:postgres/query@0.1.1-draft;
  import utils;
}
