package townframe:wflow;

/// types used across interfaces
interface types {
  type json = string;

  type job-id = string;

  record job-ctx {
    job-id: job-id,
  }

  variant retry-policy {
    immediate,
  }

  record transient-job-error {
    error-json: json,
    retry-policy: option<retry-policy>,
  }

  variant job-error {
    terminal(json),
    transient(transient-job-error),
  }

  type job-result = result<json, job-error>;

  record run-args {
    ctx: job-ctx,
    /// FIXME: find a better way of having a single component
    /// impl an interface N times
    wflow-key: string,
    args-json: json,
  }
}

/// for a component that implements wflows
interface bundle {
  use types.{run-args, job-result};

  run: func(cx: run-args) -> job-result;
}

/// for the host functionality for wflows
interface host {
  use types.{job-id, json};

  type step-id = u64;

  record completed-step-state {
    id: step-id,
    value-json: json,
  }

  record active-step-state {
    id: step-id,
  }

  variant step-state {
    active(active-step-state),
    completed(completed-step-state),
  }

  next-step: func(job-id: job-id) -> result<step-state, string>;

  persist-step: func(job-id: job-id, step-id: step-id, value-json: json) -> result<_, string>;

  sleep: func(job-id: job-id, step-id: step-id, duration-ms: u64) -> result<_, string>;

  recv-message: func(job-id: job-id, step-id: step-id) -> result<json, string>;
}

/// for starting invocations
interface ingress {
  use types.{job-id, json};

  record invoke-args {
    wflow-key: string,
    args-json: json,
    idem-key: option<string>,
  }

  variant invoke-error {
    wflow-not-found,
  }

  invoke: func(args: invoke-args) -> result<job-id, invoke-error>;
}

interface metastore {
  record wasmcloud-wflow-service-meta {
    workload-id: string,
  }

  variant wflow-service-meta {
    wasmcloud(wasmcloud-wflow-service-meta),
    local-native,
  }

  record wflow-meta {
    key: string,
    service: wflow-service-meta,
  }

  record partitions-meta {
    version: string,
    partition-count: u64,
  }

  get-wflow: func(key: string) -> option<wflow-meta>;

  get-partitions: func() -> partitions-meta;
}

interface partition-host {
  use types.{job-id};
  use metastore.{wflow-meta};
  use types.{json};

  type partition-id = u64;

  record add-job-args {
    id: job-id,
    wflow: wflow-meta,
  }

  add-job: func(partition-id: partition-id, args: add-job-args);

  send-message: func(partition-id: partition-id, job-id: job-id, payload-json: json);
}

world rt-partition-host {
  import types;
  import metastore;
  import partition-host;
}
world rt-host {
  import types;
  import host;
}
world rt-metastore {
  import metastore;
}
world service {
  import types;
  import host;

  export bundle;
}
world keyvalue {
  import wasi:keyvalue/store@0.2.0-draft;
  import wasi:keyvalue/atomics@0.2.0-draft;
  import wasi:keyvalue/batch@0.2.0-draft;
}
