---
source: src/micro_counter_manifest/lib.rs
expression: manifest()
---
schema: 1
id: dayframe.counter
package_version: 1
entrypoints:
  initialize: "townframe:dayframe/micro-lifecycle@0.4.0"
  presentation: "townframe:dayframe/presentation-events@0.4.0"
  installer: ~
publications:
  - name: view
    kind: presentation
    contract: ~
requires: []
configuration_requests:
  - binding: counter
    facets:
      - owner_plug_id: ~
        tag: org.dayframe.counter.config
        key_id: count
        read: true
        write: true
        create: false
        delete: false
collection_contracts: []
contributions:
  - id: settings-section
    collection: settings.sections
    key: dayframe.counter
    payload:
      title: Counter (Wasm)
    attachments:
      - index: 0
        publication: view
