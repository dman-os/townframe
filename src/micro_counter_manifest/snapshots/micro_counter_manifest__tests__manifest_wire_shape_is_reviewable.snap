---
source: src/micro_counter_manifest/lib.rs
expression: sidecar()
---
id: dayframe.counter
package_version: 1
authority: org.example.dayframe.counter
entrypoints:
  initialize: "townframe:dayframe/micro-lifecycle@0.4.0"
  presentation: "townframe:dayframe/presentation-events@0.4.0"
  installer: ~
publications:
  - name: view
    kind: presentation
    contract: ~
  - name: badge
    kind: presentation
    contract: ~
  - name: count
    kind: call
    contract: org.example.dayframe.counter.count
requires: []
configuration_requests:
  - binding: counter
    facets:
      - tag: org.example.dayframe.counter.config
        key_id: count
        read: true
        write: true
        create: false
        delete: false
collection_contracts: []
collection_requests:
  - binding: sections
    contract: org.example.dayframe.settings.sections
    access: write
    necessity: optional
contributions:
  - id: settings-section
    binding: sections
    key: dayframe.counter
    payload:
      detail:
        $attachment: 0
      title: Counter (Wasm)
    attachments:
      - index: 0
        publication: view
