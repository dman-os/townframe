---
source: src/micro_counter_manifest/lib.rs
expression: sidecar()
---
id: dayframe.counter
package_version: 1
authority: org.example.dayframe.counter
entrypoints:
  initialize: "townframe:dayframe/micro-lifecycle@0.4.0"
  presentation: "townframe:dayframe/presentation-events@0.4.0"
  installer: ~
endpoints:
  badge:
    $type: "org.example.clay.micro.manifest#viewEndpoint"
  count:
    $type: "org.example.clay.micro.manifest#methodEndpoint"
    nsid: org.example.dayframe.counter.count
  increment:
    $type: "org.example.clay.micro.manifest#callbackEndpoint"
    implements: org.example.dayframe.toolbar.action
  view:
    $type: "org.example.clay.micro.manifest#viewEndpoint"
requires: []
configuration_requests:
  - binding: counter
    facets:
      - tag: org.example.dayframe.counter.config
        key_id: count
        read: true
        write: true
        create: false
        delete: false
collection_contracts: []
collection_requests:
  - binding: sections
    contract: org.example.dayframe.settings.sections
    access: write
    necessity: optional
  - binding: toolbar
    contract: org.example.dayframe.toolbar.buttons
    access: write
    necessity: optional
  - binding: panels
    contract: org.example.dayframe.layout.panels
    access: write
    necessity: optional
contributions:
  - id: settings-section
    binding: sections
    key: dayframe.counter
    value:
      detail:
        $link: 0
      title: Counter (Wasm)
    links:
      - index: 0
        endpoint: view
  - id: toolbar-button
    binding: toolbar
    key: increment
    value:
      action:
        $link: 0
      icon: plus
      label: Increment
    links:
      - index: 0
        endpoint: increment
  - id: layout-panel
    binding: panels
    key: dayframe.counter
    value:
      content:
        $link: 0
      title: Counter (Wasm)
    links:
      - index: 0
        endpoint: view
