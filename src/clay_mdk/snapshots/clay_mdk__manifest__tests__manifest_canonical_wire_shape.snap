---
source: src/clay_mdk/manifest.rs
expression: "serde_json::to_string_pretty(&canonical_manifest()).unwrap()"
---
{
  "schema": 1,
  "id": "dayframe.counter",
  "package_version": 1,
  "entrypoints": {
    "initialize": "townframe:dayframe/micro-lifecycle@0.3.0",
    "presentation": "townframe:dayframe/presentation-events@0.3.0",
    "installer": null
  },
  "provides": [
    {
      "id": "controller",
      "contract": {
        "id": "wasm.controller",
        "version": 1
      },
      "retention": "strong"
    }
  ],
  "requires": [
    {
      "binding": "shelf",
      "contract": {
        "id": "dayframe.shelf",
        "version": 1
      },
      "necessity": "optional"
    }
  ],
  "configuration_requests": [
    {
      "binding": "counter",
      "facets": [
        {
          "owner_plug_id": null,
          "tag": "org.dayframe.counter.config",
          "key_id": "count",
          "read": true,
          "write": false,
          "create": false,
          "delete": false
        }
      ]
    }
  ],
  "collection_contracts": [
    {
      "id": "tallies",
      "selector_schema": "dayframe.counter.tally-selector",
      "key_schema": "dayframe.counter.tally-key",
      "value_schema": "dayframe.counter.tally",
      "write_context_schema": null,
      "offered": [
        "read",
        "register"
      ]
    }
  ],
  "contributions": [
    {
      "id": "toolbar-button",
      "target_binding": "shelf",
      "extension_contract": {
        "id": "dayframe.shelf",
        "version": 1
      },
      "payload": {
        "badges": [
          1,
          null,
          "beta"
        ],
        "enabled": true,
        "label": {
          "en": "Counter"
        },
        "order": 2,
        "slot": "toolbar"
      },
      "capability_slots": [
        {
          "index": 0,
          "contract": {
            "id": "dayframe.surface-mount",
            "version": 1
          }
        }
      ]
    }
  ],
  "activation_defaults": [
    {
      "id": "toolbar-button",
      "trigger": {
        "kind": "target-live",
        "target_binding": "shelf",
        "extension_contract": {
          "id": "dayframe.shelf",
          "version": 1
        }
      },
      "declaration_id": "toolbar-button"
    },
    {
      "id": "always-on",
      "trigger": {
        "kind": "explicit-root"
      },
      "declaration_id": "toolbar-button"
    }
  ]
}
