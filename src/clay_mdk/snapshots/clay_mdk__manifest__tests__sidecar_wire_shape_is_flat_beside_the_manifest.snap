{
  "id": "dayframe.counter",
  "package_version": 1,
  "authority": "org.example.test.counter",
  "entrypoints": {
    "initialize": "townframe:dayframe/micro-lifecycle@0.4.0",
    "presentation": "townframe:dayframe/presentation-events@0.4.0",
    "installer": null
  },
  "publications": [
    {
      "name": "view",
      "kind": "presentation",
      "contract": null
    },
    {
      "name": "increment",
      "kind": "call",
      "contract": "org.example.test.counter.increment"
    }
  ],
  "requires": [
    {
      "binding": "shelf",
      "contract": "org.example.test.shelf",
      "necessity": "optional",
      "minRevision": 2
    }
  ],
  "configuration_requests": [
    {
      "binding": "counter",
      "facets": [
        {
          "tag": "org.example.test.counter.config",
          "key_id": "count",
          "read": true,
          "write": false,
          "create": false,
          "delete": false
        }
      ]
    }
  ],
  "collection_contracts": [
    {
      "id": "org.example.test.counter.tallies",
      "selector_schema": "org.example.test.counter.tallySelector",
      "key_schema": "org.example.test.counter.tallyKey",
      "value_schema": "org.example.test.counter.tally",
      "write_context_schema": null,
      "offered": [
        "read",
        "register"
      ]
    }
  ],
  "collection_requests": [
    {
      "binding": "tally-book",
      "contract": "org.example.test.counter.tallies",
      "access": "write"
    }
  ],
  "contributions": [
    {
      "id": "toolbar-button",
      "binding": "tally-book",
      "key": "counter",
      "payload": {
        "badges": [
          1,
          null,
          "beta"
        ],
        "enabled": true,
        "label": {
          "en": "Counter"
        },
        "order": 2,
        "slot": "toolbar"
      },
      "attachments": [
        {
          "index": 0,
          "publication": "view"
        }
      ]
    }
  ]
}
