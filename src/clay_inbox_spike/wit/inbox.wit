package townframe:inbox-spike@0.1.0;

/// What the host gives the guest: a responder per request, and `gate`, a host import that
/// suspends until the host releases it (the analogue of a nested call into another micro).
interface inbox {
    resource responder {
        /// Answer the request. Dropping a responder without answering is the "handler failed
        /// to answer" signal the host observes.
        respond: func(outcome: result<list<u8>, string>);
    }

    record request {
        publication: string,
        payload: list<u8>,
        responder: responder,
    }

    gate: async func(name: string) -> list<u8>;

    /// Called by `serve` as its last act, so an engine that cannot hold the serve call's future
    /// (the polyfill has no store-task API) still observes that the serve task finished.
    finished: func();
}

/// What the guest serves: one long-lived task fed by the inbox stream, which spawns a handler
/// per request inside itself, plus a sync export that reports how many handlers are in flight.
interface server {
    use inbox.{request};

    serve: async func(inbox: stream<request>);
    in-flight: func() -> u32;
    /// The same count, read from guest `thread_local` state instead of a `static`.
    in-flight-thread-local: func() -> u32;
}

world spike {
    import inbox;
    export server;
}
