  - name: detail
    kind: presentation
    contract: ~
requires: []
configuration_requests:
  - binding: sample
    facets:
      - owner_plug_id: ~
        tag: org.dayframe.sample.config
        key_id: main
        read: true
        write: true
        create: false
        delete: false
collection_contracts: []
contributions: []
