---
source: src/micro_sample/tests.rs
expression: manifest()
---
schema: 1
id: dayframe.sample
package_version: 1
entrypoints:
  initialize: "townframe:dayframe/micro-lifecycle@0.4.0"
  presentation: "townframe:dayframe/presentation-events@0.4.0"
  installer: ~
provides:
  - id: controller
    contract:
      id: sample.controller
      version: 1
    retention: strong
requires:
  - binding: settings
    contract:
      id: settings.sections
      version: 1
    necessity: required
configuration_requests:
  - binding: sample
    facets:
      - owner_plug_id: ~
        tag: org.dayframe.sample.config
        key_id: main
        read: true
        write: true
        create: false
        delete: false
collection_contracts: []
contributions:
  - id: settings-section
    target_binding: settings
    extension_contract:
      id: settings.sections
      version: 1
    payload:
      title: Sample micro
    capability_slots: []
activation_defaults: []
