---
source: src/micro_sample/tests.rs
expression: sidecar()
---
id: dayframe.sample
package_version: 1
authority: org.example.dayframe.sample
entrypoints:
  initialize: "townframe:dayframe/micro-lifecycle@0.4.0"
  presentation: "townframe:dayframe/presentation-events@0.4.0"
  installer: ~
endpoints:
  detail:
    $type: "org.example.clay.micro.manifest#viewEndpoint"
requires: []
configuration_requests:
  - binding: sample
    facets:
      - tag: org.example.dayframe.sample.config
        key_id: main
        read: true
        write: true
        create: false
        delete: false
collection_contracts: []
collection_requests:
  - binding: sections
    contract: org.example.dayframe.settings.sections
    access: write
  - binding: panels
    contract: org.example.dayframe.layout.panels
    access: write
    necessity: optional
contributions:
  - id: layout-panel
    binding: panels
    key: dayframe.sample
    value:
      content:
        $link: 0
      title: Sample micro
    links:
      - index: 0
        endpoint: detail
