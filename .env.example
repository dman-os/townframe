OLLAMA_URL="http://localhost:11434"
OLLAMA_USERNAME="local"
OLLAMA_PASSWORD="secret"

# Keep Cargo outputs outside the checkout. The shell scopes this per worktree.
# CARGO_TARGET_DIR="/tmp/townframe-target"

# Opt into the shared cross-worktree compiler cache.
# TOWNFRAME_SCCACHE="1"
# SCCACHE_DIR="/tmp/townframe-sccache"
# SCCACHE_CACHE_SIZE="8G"
# SCCACHE_BASEDIRS="/path/to/worktrees"
